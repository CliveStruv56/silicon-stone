# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto Claude data directory
.auto-claude/

# Claude Code local state (settings, plans, memory, transcripts)
.claude/

# Playwright MCP logs
.playwright-mcp/

# Debug logs
debug_error.log

# Local tooling outputs — not part of the project source (avoid accidental
# `git add .` committing generated graphs/exports that may embed private content)
/generated-docs/
/outputs/
/.agents/
.understand-anything/

# local-draft pipeline scratch (intermediate JSON between model steps)
.local-draft/

# serwist build output (generated from src/app/sw.ts at build time)
/public/sw.js
/public/sw.js.map
/public/swe-worker*
