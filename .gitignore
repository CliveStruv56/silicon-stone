# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto Claude data directory
.auto-claude/

# Claude Code local state (settings, plans, memory, transcripts)
.claude/

# Playwright MCP logs
.playwright-mcp/

# Debug logs
debug_error.log

# Local tooling outputs — not part of the project source (avoid accidental
# `git add .` committing generated graphs/exports that may embed private content)
/generated-docs/
/outputs/
/.agents/
.understand-anything/

# Visual-review scratch: throwaway puppeteer scripts + full-page screenshots
# (~60MB and growing). Regenerate with the scripts inside it, never commit.
/design-review/

# Ad-hoc verification screenshots dropped at the repo root by browser tooling
# (p1-*.png, troy-*.jpeg, etc.). Real site assets live in /public.
/*.png
/*.jpg
/*.jpeg

# Built product deliverables — regenerable from deliverables/src via
# assemble-toolkit.mjs / build-spreadsheets.mjs; the PDFs/spreadsheets are
# uploaded to Lemon Squeezy, not served from the repo.
/deliverables/dist/

# Python bytecode from the Railway backend
__pycache__/
*.py[cod]

# Stray `sanity init` artifact (a lone package-lock.json, no project)
/studio-silicon-and-stone/

# Generic skills live in ~/.claude/skills; domain skills belong in .agent/skills
/skills/
# Packaged (zipped) skill exports — the unpacked copy in .agent/skills is source
/docs/*.skill

# local-draft pipeline scratch (intermediate JSON between model steps)
.local-draft/

# serwist build output (generated from src/app/sw.ts at build time)
/public/sw.js
/public/sw.js.map
/public/swe-worker*
