# Sanity Configuration - Silicon and Stone
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-13

# API token for preview/draft mode
SANITY_API_READ_TOKEN=your_sanity_read_token

# API token for content sync (Editor permissions required)
SANITY_API_WRITE_TOKEN=your_sanity_write_token
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret
SANITY_REVALIDATE_SECRET=your_sanity_revalidate_secret


# Local markdown content directory (used only by npm run sync-content)
AI_WRITER_CONTENT_PATH=../content/substack

# Writer Studio Access
ADMIN_PASSWORD=replace_with_a_strong_unique_password
SESSION_SECRET=replace_with_a_long_random_session_secret_at_least_32_chars

# Durable abuse / cost controls. Vercel's Upstash/KV integration injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead — the limiter reads either pair.
# If neither is set it degrades to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Inoreader Configuration
INOREADER_APP_ID=your_inoreader_app_id
INOREADER_APP_KEY=your_inoreader_app_key

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the Claude model used for generation/editing passes.
# Defaults to claude-sonnet-4-6. Add any new id to src/lib/pricing.ts too.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Exa.ai Web Search
EXA_API_KEY=your_exa_api_key

# OpenAI / Pinecone semantic search
OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_pinecone_index_name
PINECONE_EVIDENCE_INDEX_NAME=your_separate_evidence_index_name
# Regulatory retrieval corpus — primary statutory text for drafting at /create.
# Must be a plain DENSE index with NO integrated embed config (this app supplies
# its own OpenAI vectors). Provision it with: npm run reg:verify-index -- --create
PINECONE_REGULATORY_INDEX_NAME=your_regulatory_corpus_index_name
# Optional. One corpus version is live at a time; a cutover ingests into a new
# namespace, verifies the count, flips this, then deletes the old namespace.
PINECONE_REGULATORY_NAMESPACE=

# ConvertKit / Kit — one form site-wide; every audience distinction is a tag.
# Missing tag IDs are skipped gracefully (subscribe still succeeds). See LAUNCH.md.
CONVERTKIT_API_KEY=your_kit_api_key
CONVERTKIT_FORM_ID=your_kit_form_id
CONVERTKIT_CONTACT_TAG_ID=your_contact_tag_id
CONVERTKIT_TOOL_LEAD_TAG_ID=your_tool_lead_tag_id
CONVERTKIT_WAYMARKPATH_TAG_ID=your_waymarkpath_tag_id
# Early access + tier requested (pre-launch product CTAs)
CONVERTKIT_EARLY_ACCESS_TAG_ID=
CONVERTKIT_TIER_CHECKLIST_TAG_ID=
CONVERTKIT_TIER_TOOLKIT_STANDARD_TAG_ID=
CONVERTKIT_TIER_TOOLKIT_PROFESSIONAL_TAG_ID=
CONVERTKIT_TIER_SECTOR_REPORTS_TAG_ID=
# Source segments (landing pages)
CONVERTKIT_ATLANTIC_DRIFT_TAG_ID=
CONVERTKIT_EU_EXPOSURE_TAG_ID=
# Tool results subscribe blocks
CONVERTKIT_TOOL_COMPLIANCE_CHECKER_TAG_ID=
CONVERTKIT_TOOL_SUPPLY_CHAIN_MAPPER_TAG_ID=
CONVERTKIT_TOOL_SCENARIO_MODELER_TAG_ID=
CONVERTKIT_TOOL_POLICY_STRESS_TEST_TAG_ID=
# Buyer tags (applied by the Lemon Squeezy order_created webhook)
CONVERTKIT_BUYER_CHECKLIST_TAG_ID=
CONVERTKIT_BUYER_TOOLKIT_STANDARD_TAG_ID=
CONVERTKIT_BUYER_TOOLKIT_PRO_TAG_ID=

# Public app configuration
NEXT_PUBLIC_APP_URL=https://siliconandstone.com
# Canonical site origin (bare apex) for metadata, canonicals, OG, JSON-LD, sitemap.
# Override per-environment (e.g. a preview deploy); defaults to the apex. www
# 308-redirects here, so this must match the Vercel domain redirect target.
NEXT_PUBLIC_SITE_URL=https://siliconandstone.com
NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
BACKEND_API_URL=https://your-railway-backend.up.railway.app
BACKEND_API_KEY=replace_with_a_long_random_shared_secret
# Subscribe posts DIRECT to Kit unless this is "true" (Railway proxy opt-in;
# requires the backend to have ConvertKit configured and `tags` support).
SUBSCRIBE_VIA_BACKEND=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=siliconandstone.com
# Unused since 2026-08-06: the Adjacent Block and footer both link to the
# internal /waymarkpath page. Kept for when the external app is linked again.
NEXT_PUBLIC_WAYMARKPATH_URL=https://waymarkpath.vercel.app
NEXT_PUBLIC_LEMONSQUEEZY_CHECKLIST_URL=
NEXT_PUBLIC_LEMONSQUEEZY_TOOLKIT_STANDARD_URL=
NEXT_PUBLIC_LEMONSQUEEZY_TOOLKIT_PROFESSIONAL_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Lemon Squeezy (server-side; see docs/lemonsqueezy-setup.md + LAUNCH.md)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# Variant IDs per SKU — map order_created webhooks to Kit buyer tags
LEMONSQUEEZY_VARIANT_ID_CHECKLIST=
LEMONSQUEEZY_VARIANT_ID_TOOLKIT_STANDARD=
LEMONSQUEEZY_VARIANT_ID_TOOLKIT_PRO=

# Launch flags (see src/lib/flags.ts and LAUNCH.md). All default to true when
# unset. Flip PRE_LAUNCH to false at launch to turn product CTAs into Buy
# buttons wired to Lemon Squeezy checkout.
NEXT_PUBLIC_PRE_LAUNCH=true
NEXT_PUBLIC_FOUNDING_OFFER_ACTIVE=true
NEXT_PUBLIC_FREE_INTRO_WINDOW=true
# End of the free-intro window: launch date + 90 days, ISO format (e.g. 2026-12-31)
NEXT_PUBLIC_FREE_INTRO_END=
# Calendar/booking link for the 25-minute intro call (shown on enquiry success)
NEXT_PUBLIC_BOOKING_URL=

# Railway logic API
ALLOWED_ORIGINS=http://localhost:3000,https://siliconandstone.com
ENABLE_API_DOCS=false
# Use the same Upstash Redis instance when possible so deep-research job state,
# idempotency, and active-job budget survive restarts.
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379
